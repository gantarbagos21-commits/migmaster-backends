{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "migmaster-backends",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "durable_objects": {
    "bindings": [
      {
        "name": "MIGMASTER_SESSION",
        "class_name": "MigMasterSession"
      }
    ]
  },
  "exports": {
    "MigMasterSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
